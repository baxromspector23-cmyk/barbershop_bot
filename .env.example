# ==============================================================================
# TELEGRAM BARBERSHOP QUEUE BOT CONFIGURATION
# ==============================================================================

# Telegram Bot Token (obtained from @BotFather)
BOT_TOKEN=123456789:CHANGE_ME_BOT_TOKEN_PLACEHOLDER

# Comma-separated Telegram User IDs who automatically become OWNER on first /start
OWNER_TELEGRAM_IDS=123456789,987654321

# Environment: 'development' | 'production' | 'test'
ENV=development

# Timezone (Default: Asia/Tashkent, UTC+5)
TIMEZONE=Asia/Tashkent

# ==============================================================================
# DATABASE & CACHE
# ==============================================================================
# Pooled PostgreSQL URL (compatible with PgBouncer transaction mode)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/barbershop

# Direct database connection URL (used exclusively by Alembic migrations when bypassing PgBouncer)
DATABASE_DIRECT_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/barbershop

# Redis URL for FSM storage and rate limiting (leave empty to fallback to MemoryStorage)
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# RUN MODE & WEBHOOK / SERVERLESS
# ==============================================================================
# Bot execution mode: 'polling' (for local dev) | 'webhook' (for production / serverless)
RUN_MODE=polling

# HTTP Server Host and Port
HOST=0.0.0.0
PORT=8080

# Public base URL for webhook (e.g. https://barbershop.example.com or Cloud Run URL)
WEBHOOK_BASE_URL=https://barbershop.example.com

# Random secret token sent in X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=CHANGE_ME_super_secret_webhook_telegram_token_32chars

# Random path secret appended to /webhook/<WEBHOOK_PATH_SECRET>
WEBHOOK_PATH_SECRET=CHANGE_ME_random_path_secret_route_key_48chars

# Domain name for Caddy automatic HTTPS (used in docker-compose)
DOMAIN=barbershop.example.com

# ==============================================================================
# CRON SCHEDULER & DUE WORK
# ==============================================================================
# Secret key required in X-Cron-Secret header for POST /internal/tick
CRON_SECRET=CHANGE_ME_super_secret_cron_tick_token_key_32chars

# Internal 15-second scheduler loop: 'true' (for VPS/docker-compose) | 'false' (for serverless cron)
INTERNAL_SCHEDULER=true

# ==============================================================================
# QUEUE RULES & PARAMETERS
# ==============================================================================
# Client arrival deadline in minutes when called (default: 10)
LATE_MINUTES=10

# Maximum times a client can be moved back before cancellation (default: 2)
MAX_LATE_MOVES=2

# Number of clients ahead to trigger heads-up alert (default: 1)
HEADS_UP_AHEAD=1

# Whether barbers can edit their own services and prices: 'true' | 'false'
ALLOW_BARBER_EDIT_OWN_SERVICES=true

# ==============================================================================
# PAYMENTS CONFIGURATION
# ==============================================================================
# Payments mode: 'test' | 'live' (NOTE: 'test' is rejected if ENV=production)
PAYMENTS_MODE=test

# Enabled payment methods (comma-separated): CASH,CLICK,PAYME
# Manual payments: CASH (barber confirms) and TRANSFER (client pays to the card below and sends a photo of the receipt).
# Online providers (CLICK, PAYME) are optional and need real provider tokens.
ENABLED_PAYMENT_METHODS=CASH,TRANSFER
# Card that receives TRANSFER payments (16 digits) and the name shown to clients
PAYMENT_CARD_NUMBER=0000 0000 0000 0000
PAYMENT_CARD_HOLDER=CHANGE_ME card holder name
# Max active clients per barber; further clients are told the queue is full
MAX_QUEUE_PER_BARBER=12
# Working hours enforcement: false (open 24/7, barbers decide when to pause) | true (strict schedule)
CHECK_WORKING_HOURS=false
# Flood control: max receipt reminders dispatched per tick (default: 10)
RECEIPT_REMINDER_MAX_PER_TICK=10

# Click Provider Token from @BotFather (Payments -> Click)
CLICK_PROVIDER_TOKEN=398061295:TEST:99999

# Payme Provider Token from @BotFather (Payments -> Payme)
PAYME_PROVIDER_TOKEN=371317599:TEST:11111

# Paynet Merchant Integration (UWS Connector / Web Checkout)
PAYNET_ENABLED=false
PAYNET_SERVICE_ID=your_paynet_service_id
PAYNET_SECRET_KEY=your_paynet_secret_key

# ==============================================================================
# UI CUSTOMIZATION: BUTTON STYLES & EMOJI
# ==============================================================================
# Use Telegram Premium custom emoji on buttons (requires bot owner to have Telegram Premium)
USE_PREMIUM_EMOJI=true

# Instagram profile URL shown in the client menu (leave empty to hide button)
INSTAGRAM_URL=https://www.instagram.com/jasur_barber_98

# ==============================================================================
# OWNER-ONLY WEBSITE (READ-ONLY CLIENT LIST & VISIT HISTORY)
# ==============================================================================
# Enable the owner-only website (default: false)
SITE_ENABLED=false
SITE_USERNAME=owner
# Generate both values below with: python scripts/make_site_password_hash.py
SITE_PASSWORD_HASH=
SITE_SESSION_SECRET=
# Secure cookies (must be true in production over HTTPS)
SITE_SECURE_COOKIES=true
# Trust X-Forwarded-For header when running behind Caddy reverse proxy
SITE_TRUST_PROXY=false
# Port for the owner-only website (separate from the bot's webhook port)
SITE_PORT=8081
# Domain name for the owner-only website in Caddy
SITE_DOMAIN=site.localhost

